    {
      "name": "02 - Catalog",
      "item": [
        {
          "name": "CAT-01 - Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const products = pm.response.json();",
                  "pm.test('Devuelve productos', () => pm.expect(products).to.be.an('array').that.is.not.empty);",
                  "const product = products[0];",
                  "pm.test('Producto con id, name y price', () => { pm.expect(product).to.have.property('id'); pm.expect(product).to.have.property('name'); pm.expect(product).to.have.property('price'); });",
                  "pm.environment.set('productId', product.id);",
                  "pm.environment.set('productName', product.name);",
                  "pm.environment.set('productPrice', Number(product.price));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/catalog/products?page=1&size=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "catalog",
                "products"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
