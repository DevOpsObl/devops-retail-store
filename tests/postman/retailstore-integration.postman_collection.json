    {
      "name": "04 - Checkout",
      "item": [
        {
          "name": "CHECKOUT-01 - Iniciar checkout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const checkout = pm.response.json();",
                  "const productPrice = Number(pm.environment.get('productPrice'));",
                  "const expectedSubtotal = productPrice * 2;",
                  "pm.test('Checkout contiene el producto seleccionado', () => { pm.expect(checkout.items).to.be.an('array').with.lengthOf(1); pm.expect(checkout.items[0].id).to.eql(pm.environment.get('productId')); pm.expect(checkout.items[0].quantity).to.eql(2); });",
                  "pm.test('Dirección de envío registrada', () => pm.expect(checkout.shippingAddress.email).to.eql('postman-devops-test@example.com'));",
                  "pm.test('Opción de envío aplicada', () => pm.expect(checkout.deliveryOptionToken).to.eql('priority-mail'));",
                  "pm.test('Totales calculados', () => { pm.expect(checkout.subtotal).to.eql(expectedSubtotal); pm.expect(checkout.shipping).to.eql(10); pm.expect(checkout.tax).to.eql(5); pm.expect(checkout.total).to.eql(expectedSubtotal + 15); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"id\": \"{{productId}}\",\n      \"name\": \"{{productName}}\",\n      \"quantity\": 2,\n      \"price\": {{productPrice}}\n    }\n  ],\n  \"shippingAddress\": {\n    \"firstName\": \"Postman\",\n    \"lastName\": \"Tester\",\n    \"email\": \"postman-devops-test@example.com\",\n    \"address1\": \"18 de Julio 1234\",\n    \"address2\": \"Apt 101\",\n    \"city\": \"Montevideo\",\n    \"state\": \"Montevideo\",\n    \"zip\": \"11200\"\n  },\n  \"deliveryOptionToken\": \"priority-mail\"\n}"
            },
